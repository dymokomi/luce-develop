## Paper `at` (0-based in the Paper menu's order).
pub func paper_at(at: usize) -> PaperStock:
    return match at:
        0 => ilford_multigrade_iv_rc()
        1 => kodak_polymax_ii_rc()
        2 => kodak_polycontrast_iv_rc()
        3 => kodak_endura_premier()
        4 => kodak_portra_endura()
        _ => kodak_supra_endura()
