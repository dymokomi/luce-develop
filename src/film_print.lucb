## Print: scene light printed on Kodak Vision 2383 and projected, as a view. This
## is the cinema's release print, the classic "film look" of print-emulation LUTs,
## and it replaces the view's tone scale instead of stacking on it: the print's
## own toe and shoulder are the tone mapping.
##
## 1. Printing density. The graded scene, channel by channel, is held as a
##    negative's printing density the Cineon way: 0.6 density per decade of
##    scene light, grey (0.18) at 0.70 over D-min. Printing density is by
##    definition the density the print stock sees, so each print layer's log
##    exposure is its printer light less the negative's density.
## 2. Printer lights put grey on the print's visual neutral of density 1.0: the
##    amounts of dye Kodak's normalized curves define (each 1.0), so grey shows
##    at a tenth of the print's white, as a cinema shows it.
## 3. The print develops each layer through its characteristic curve (Status A,
##    unmixed into dye amounts as film_model.lucb does for negatives; the layers
##    of a print do not hold each other back).
## 4. With the bleach bypassed (ENR, CCE), silver kept beside the dyes, neutral
##    density where the print is dense (`print_silver_density`).
## 5. Projection: the dyes' spectral density under a xenon arc (taken as a 5600 K
##    black body), white the clear print, 0.2% of white added as projector flare,
##    and the eye adapted to the screen: the light's white goes to the display's.
import memory
import sync
from luce_std import math
from luce_color import spectral
from luce_color import xyz
from film_stocks import PrintStock, kodak_2383
import film_stocks

## The printing-density encoding: density per decade of scene light, and grey's.
let negative_gamma: f64 = 0.6
let grey_density: f64 = 0.7
## Projector flare, a share of white; and the projector's light.
let projector_flare: f64 = 0.002
let projector_kelvin: f64 = 5600.0

## A print's development over log H: 1024 samples over its stock's range (2383's
## from -1.5 to 3.5).
let samples: usize = 1024

## A print material's model: its stock, its development unmixed into dye
## amounts, the light it is seen by, its flare. 2383 projected here; a color
## paper seen by reflection (film_paper.lucb).
pub struct PrintModel:
    var stock: PrintStock
    var low: f64
    var high: f64
    ## Where grey prints: each layer's dye amount 1.0 (Kodak's print dyes make a
    ## visual neutral of 1.0 there), or, when set, each layer's density over
    ## base (a paper's mid-grey, 0.70).
    var grey_density: f64
    var flare: f64
    ## Dye amounts per layer over log H, the layers' printer lights (grey's log H),
    ## and Status A's bands.
    var curve: f64[3072]
    var printer: f64[3]
    var bands: f64[243]
    ## The projector's light, the clear print's white under it, and the matrix from
    ## that white to D65 (Bradford).
    var light: spectral.Spectrum
    var white: xyz.XYZ
    var adapt: xyz.Matrix3

    ## Status A densities of dye `amounts` (cyan, magenta, yellow) over the base.
    func read(amounts: f64[3]) -> f64[3]:
        var out: f64[3]
        for channel in 0..<(usize)3:
            var sum = 0.0
            for at in 0..<spectral.samples:
                let d = amounts[0] * self.stock.dyes[at] + amounts[1] * self.stock.dyes[81 + at] + amounts[2] * self.stock.dyes[162 + at]
                sum += math.pow(10.0, -d) * self.bands[channel * 81 + at]
            out[channel] = -math.log10(math.max(sum, 1.0e-12))
        return out

    ## Layer `layer`'s dye at log H `log_h`.
    func amount(layer: usize, log_h: f64) -> f64:
        let position = math.clamp((log_h - self.low) / (self.high - self.low), 0.0, 1.0) * (f64)(samples - 1)
        let below = (usize)math.min(math.floor(position), (f64)(samples - 2))
        let t = position - (f64)below
        return self.curve[below * 3 + layer] * (1.0 - t) + self.curve[(below + 1) * 3 + layer] * t

## Status A densitometry's bands (blue near 440 nm, green 545, red 610), as
## Gaussians: the standard's tables are not public.
func status_a() -> f64[243]:
    var out: f64[243]
    let centers: f64[3] = [610.0, 545.0, 440.0]
    let widths: f64[3] = [12.0, 12.0, 12.0]
    for channel in 0..<(usize)3:
        var sum = 0.0
        for at in 0..<spectral.samples:
            let d = (spectral.wavelength(at) - centers[channel]) / widths[channel]
            out[channel * 81 + at] = math.exp(-0.5 * d * d)
            sum += out[channel * 81 + at]
        for at in 0..<spectral.samples:
            out[channel * 81 + at] /= sum
    return out

## Layer `channel`'s Status A density over the print's D-min at `log_h`, held at
## the ends of what Kodak plots.
func over_minimum(stock: const PrintStock*, channel: usize, log_h: f64) -> f64:
    let n = stock.curve_count
    let curve = stock.curves[channel * film_stocks.curve_most..<channel * film_stocks.curve_most + n]
    var least = curve[0]
    for value in curve:
        least = math.min(least, value)
    let position = math.clamp((log_h - stock.curve_first) / stock.curve_step, 0.0, (f64)(n - 1))
    let below = (usize)math.min(math.floor(position), (f64)(n - 2))
    let t = position - (f64)below
    return curve[below] + (curve[below + 1] - curve[below]) * t - least

## Fill `out` (its stock, bands and light set): the curves, printer lights and white.
func build(out: PrintModel*):
    # The neutral ramp unmixed into dye amounts, by Newton from the last.
    var a: f64[3] = [0.0, 0.0, 0.0]
    for at in 0..<samples:
        let log_h = out.low + (out.high - out.low) * (f64)at / (f64)(samples - 1)
        let target: f64[3] = [over_minimum(&out.stock, 0, log_h), over_minimum(&out.stock, 1, log_h), over_minimum(&out.stock, 2, log_h)]
        for _ in 0..<30:
            let here = out.read(a)
            let residual: f64[3] = [here[0] - target[0], here[1] - target[1], here[2] - target[2]]
            if math.abs(residual[0]) + math.abs(residual[1]) + math.abs(residual[2]) < 1.0e-7:
                break
            var jacobian: f64[9]
            for k in 0..<(usize)3:
                var nudged = a
                nudged[k] += 1.0e-4
                let moved = out.read(nudged)
                for row in 0..<(usize)3:
                    jacobian[row * 3 + k] = (moved[row] - here[row]) / 1.0e-4
            let inverse = invert(jacobian) else break
            for k in 0..<(usize)3:
                a[k] -= inverse[k * 3] * residual[0] + inverse[k * 3 + 1] * residual[1] + inverse[k * 3 + 2] * residual[2]
        # A layer's dye only grows with its exposure (unmixing near D-min can
        # wobble one against another).
        for k in 0..<(usize)3:
            let before = out.curve[(at - 1) * 3 + k] if at > 0 else 0.0
            out.curve[at * 3 + k] = math.max(math.max(a[k], 0.0), before)
    # Printer lights: each layer's log H where it forms grey's dye (1.0), or
    # reaches grey's density over base.
    for layer in 0..<(usize)3:
        out.printer[layer] = out.high
        var previous = 0.0
        for at in 0..<samples:
            let log_h = out.low + (out.high - out.low) * (f64)at / (f64)(samples - 1)
            let reached = over_minimum(&out.stock, layer, log_h) if out.grey_density > 0.0 else out.curve[at * 3 + layer]
            let aim = out.grey_density if out.grey_density > 0.0 else 1.0
            if at > 0 and reached >= aim:
                let t = (aim - previous) / math.max(reached - previous, 1.0e-9)
                out.printer[layer] = out.low + (out.high - out.low) * ((f64)(at - 1) + t) / (f64)(samples - 1)
                break
            previous = reached
    out.white = out.light.xyz()
    let white_point = xyz.Chromaticity(out.white.x / (out.white.x + out.white.y + out.white.z), out.white.y / (out.white.x + out.white.y + out.white.z))
    out.adapt = xyz.adapt(white_point, xyz.d65)

func invert(m: f64[9]) -> f64[9]?:
    let det = m[0] * (m[4] * m[8] - m[5] * m[7]) - m[1] * (m[3] * m[8] - m[5] * m[6]) + m[2] * (m[3] * m[7] - m[4] * m[6])
    if math.abs(det) < 1.0e-14:
        return none
    return [(m[4] * m[8] - m[5] * m[7]) / det, (m[2] * m[7] - m[1] * m[8]) / det, (m[1] * m[5] - m[2] * m[4]) / det,
            (m[5] * m[6] - m[3] * m[8]) / det, (m[0] * m[8] - m[2] * m[6]) / det, (m[2] * m[3] - m[0] * m[5]) / det,
            (m[3] * m[7] - m[4] * m[6]) / det, (m[1] * m[6] - m[0] * m[7]) / det, (m[0] * m[4] - m[1] * m[3]) / det]

## Built once, on first use, and kept.
var built: PrintModel*? = none
var built_once: sync.Once

func build_model():
    built = make(kodak_2383(), projector_kelvin, -1.5, 3.5, 0.0, projector_flare)

## A model of `stock` seen by a black body of `kelvin`, developed over log H
## `low`..`high`, grey at `grey_at` density over base (0: dye 1.0), with `flare`
## (a share of white); kept for the program's life.
pub func make(stock: PrintStock, kelvin: f64, low: f64, high: f64, grey_at: f64, flare: f64) -> PrintModel*:
    let made = new PrintModel(stock = stock, low = low, high = high, grey_density = grey_at, flare = flare, bands = status_a(),
                              light = spectral.planck(kelvin)) in memory.heap catch failure:
        trap("the print model could not be allocated")
    build(made)
    return made

## Layer `layer`'s dye in `model` at log H `log_h`, and its printer light (grey's
## log H).
pub func amount_in(model: const PrintModel*, layer: usize, log_h: f64) -> f64:
    return model.amount(layer, log_h)
pub func printer_of(model: const PrintModel*, layer: usize) -> f64:
    return model.printer[layer]

## Dye `amounts` in `model` (plus `neutral`, density of silver alike at every
## wavelength), seen by its light: XYZ adapted to D65, white at Y = 1, its flare
## added.
pub func seen(model: const PrintModel*, amounts: f64[3], neutral: f64 = 0.0) -> xyz.XYZ:
    var shown = xyz.XYZ(0.0, 0.0, 0.0)
    for at in 0..<spectral.samples:
        let d = amounts[0] * model.stock.dyes[at] + amounts[1] * model.stock.dyes[81 + at] + amounts[2] * model.stock.dyes[162 + at] + neutral
        let power = model.light.values[at] * math.pow(10.0, -d)
        shown.x += power * spectral.observer[at * 3]
        shown.y += power * spectral.observer[at * 3 + 1]
        shown.z += power * spectral.observer[at * 3 + 2]
    let scale = 1.0 / (model.white.y * (1.0 + model.flare))
    let lit = xyz.XYZ((shown.x + model.flare * model.white.x) * scale, (shown.y + model.flare * model.white.y) * scale,
                      (shown.z + model.flare * model.white.z) * scale)
    return xyz.apply(model.adapt, lit)

## Silver left in a print whose bleach was bypassed (Technicolor's ENR,
## Deluxe's CCE, skip bleach): neutral density per unit of the print's own
## density over its base, all of it kept. Labs' infrared readings put a fully
## unbleached print 1.8 over normal at a D-max near 4: 0.45. The silver sits
## where the print is dense, in the shadows: blacks deepen, color drains there.
let print_silver_density: f64 = 0.45

## The share of a print's silver kept for its infrared density at D-max, the
## number labs set ENR and CCE by (an IR densitometer at 1000 nm, which sees the
## silver and hardly the dyes): a normal print reads 0.60, one with no bleach at
## all 2.40 (ENR runs 0.40–1.00, CCE about 1.85; American Cinematographer, 1998).
pub func silver_kept(infrared: f64) -> f64:
    return math.clamp((infrared - 0.6) / 1.8, 0.0, 1.0)

## Scene light `rgb` (AP1) printed and projected: XYZ adapted to D65, the print's
## white at Y = 1. `silver` is the share of the print's silver kept (0..1).
pub func projected(rgb: f64[3], silver: f64 = 0.0) -> xyz.XYZ:
    built_once.run(build_model)
    let model = built else trap("the print model was not built")
    var amounts: f64[3]
    for layer in 0..<(usize)3:
        let negative = negative_gamma * math.log10(math.max(rgb[layer], 1.0e-6) / 0.18)
        amounts[layer] = model.amount(layer, model.printer[layer] - negative)
    # The kept silver: the dyes' amounts are visual densities (Kodak's
    # normalized dyes make a visual neutral of 1.0 at 1.0 each), so their mean
    # is the print's density over its base.
    let kept = silver * print_silver_density * math.max((amounts[0] + amounts[1] + amounts[2]) / 3.0, 0.0)
    return seen(model, amounts, kept)

test "grey prints near a tenth of white, neutral; white shows white and black near black":
    # Kodak's normalized dyes, as read, make a visual density of 0.93, not 1.0.
    let grey = projected([0.18, 0.18, 0.18])
    assert(grey.y > 0.09 and grey.y < 0.13)
    let x = grey.x / (grey.x + grey.y + grey.z)
    let y = grey.y / (grey.x + grey.y + grey.z)
    assert(math.abs(x - 0.3127) < 0.01 and math.abs(y - 0.329) < 0.01)
    let white = projected([20.0, 20.0, 20.0])
    assert(white.y > 0.8)
    let black = projected([0.0005, 0.0005, 0.0005])
    assert(black.y < 0.01)
    var previous = -1.0
    for step in 0..<(usize)30:
        let v = 0.0005 * math.exp2((f64)step * 0.5)
        let shown = projected([v, v, v]).y
        assert(shown >= previous - 1.0e-4)
        previous = shown

test "silver kept in a print deepens its shadows, leaves its whites":
    # A shadow above the projector's flare.
    let shadow = projected([0.05, 0.05, 0.05])
    let kept = projected([0.05, 0.05, 0.05], 1.0)
    assert(kept.y < shadow.y * 0.6)
    let white = projected([20.0, 20.0, 20.0], 1.0)
    assert(white.y > 0.75)
