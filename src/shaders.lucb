pub let develop_frag_msl: c.str = "#pragma clang diagnostic ignored \"-Wmissing-prototypes\"\n\n#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float4 rect;\n    float4 row0;\n    float4 row1;\n    float4 row2;\n    float4 color;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstatic inline __attribute__((always_inline))\nfloat3 with_tone(thread const float3& c, texture2d<float> tone, sampler toneSmplr)\n{\n    float y = dot(c, float3(0.272228717803955078125, 0.674081742763519287109375, 0.053689517080783843994140625));\n    if (y <= 1.0000000133514319600180897396058e-10)\n    {\n        return c;\n    }\n    float l = log2(y / 0.180000007152557373046875);\n    float u = (fast::clamp((l + 14.0) / 24.0, 0.0, 1.0) * 0.99609375) + 0.001953125;\n    return c * exp2(tone.sample(toneSmplr, float2(u, 0.5)).x);\n}\n\nstatic inline __attribute__((always_inline))\nfloat3 cube_root(thread const float3& v)\n{\n    return sign(v) * powr(abs(v), float3(0.3333333432674407958984375));\n}\n\nstatic inline __attribute__((always_inline))\nfloat3 with_color(thread const float3& c, constant Params& params)\n{\n    float vibrance = params.color.x;\n    float saturation = params.color.y;\n    if ((vibrance == 0.0) && (saturation == 0.0))\n    {\n        return c;\n    }\n    float3 param = float3x3(float3(0.631694018840789794921875, 0.2700701653957366943359375, 0.098790265619754791259765625), float3(0.3488616049289703369140625, 0.630951464176177978515625, 0.18532155454158782958984375), float3(0.01933518983423709869384765625, 0.09900529682636260986328125, 0.71636784076690673828125)) * c;\n    float3 lab = float3x3(float3(0.2104542553424835205078125, 1.9779984951019287109375, 0.025904037058353424072265625), float3(0.793617784976959228515625, -2.428592205047607421875, 0.782771766185760498046875), float3(-0.004072046838700771331787109375, 0.4505937099456787109375, -0.8086757659912109375)) * cube_root(param);\n    float chroma = length(lab.yz);\n    float scale = (1.0 + saturation) * (1.0 + (vibrance * (1.0 - smoothstep(0.0, 0.20000000298023223876953125, chroma))));\n    float3 _160 = lab;\n    float2 _162 = _160.yz * fast::max(scale, 0.0);\n    lab.y = _162.x;\n    lab.z = _162.y;\n    float3 lms = float3x3(float3(1.0), float3(0.3963377773761749267578125, -0.1055613458156585693359375, -0.089484177529811859130859375), float3(0.21580375730991363525390625, -0.06385417282581329345703125, -1.2914855480194091796875)) * lab;\n    return float3x3(float3(2.06880283355712890625, -0.876328527927398681640625, -0.058594226837158203125), float3(-1.175172328948974609375, 2.14976024627685546875, -0.3940730988979339599609375), float3(0.106575958430767059326171875, -0.2734540402889251708984375, 1.4519751071929931640625)) * ((lms * lms) * lms);\n}\n\nstatic inline __attribute__((always_inline))\nfloat3 shaped(thread const float3& c)\n{\n    float3 stops = log2(fast::max(c, float3(9.9999999600419720025001879548654e-13)) / float3(0.180000007152557373046875));\n    return fast::clamp((stops - float3(-12.0)) / float3(24.0), float3(0.0), float3(1.0));\n}\n\nstatic inline __attribute__((always_inline))\nfloat3 through_view(thread const float3& c, texture2d<float> display_table, sampler display_tableSmplr)\n{\n    float3 param = c;\n    float3 s = shaped(param) * 63.0;\n    float slice = floor(s.z);\n    float next = fast::min(slice + 1.0, 63.0);\n    float t = s.z - slice;\n    float2 at = float2(s.x + 0.5, s.y + 0.5);\n    float3 low = display_table.sample(display_tableSmplr, float2(((slice * 64.0) + at.x) / 4096.0, at.y / 64.0)).xyz;\n    float3 high = display_table.sample(display_tableSmplr, float2(((next * 64.0) + at.x) / 4096.0, at.y / 64.0)).xyz;\n    return mix(low, high, float3(t));\n}\n\nfragment luce_fragment_out luce_fragment(constant Params& params [[buffer(0)]], texture2d<float> scene [[texture(1)]], texture2d<float> tone [[texture(2)]], texture2d<float> display_table [[texture(3)]], sampler sceneSmplr [[sampler(1)]], sampler toneSmplr [[sampler(2)]], sampler display_tableSmplr [[sampler(3)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    float2 uv = (gl_FragCoord.xy - params.rect.xy) / params.rect.zw;\n    float3 camera = scene.sample(sceneSmplr, uv).xyz;\n    float3 c = float3(dot(params.row0.xyz, camera), dot(params.row1.xyz, camera), dot(params.row2.xyz, camera));\n    float3 param = fast::max(c, float3(0.0));\n    c = with_tone(param, tone, toneSmplr);\n    float3 param_1 = c;\n    c = with_color(param_1, params);\n    float3 param_2 = c;\n    out.fragment_color = float4(through_view(param_2, display_table, display_tableSmplr), 1.0);\n    return out;\n}\n\n"
