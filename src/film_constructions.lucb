        # Protective overcoat: overcoat
        Layer(dry = 1.0, record = -1, coupler = 0.0, equivalence = 4.0, k_couple = 0.0, k_dir = 0.0, dir_coupler = 0.0, timed = false, scavenger = 0.0, halide = 0.0, sites = 0.0, cells = 1),
