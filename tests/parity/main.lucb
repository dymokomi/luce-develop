## The GPU renderer held to the CPU develop: each file on the command line (by
## default a Leica DNG, a Fuji X-Trans RAF and a Sony ARW from luce-raw's sample
## raws checked out beside this package; skipped when they are not) is developed
## both ways with several settings into 8-bit sRGB, and the pictures
## must agree: the mean difference under 1 level and fewer than 0.1% of values
## off by more than 6. The Standard and Linear views are computed the same way on
## both, so no value may be off by 3 (8 with film, which runs nine half-float
## passes first); ACES and Print go through a table on the GPU, so their limit
## is 40. A recipe with two outputs draws A left of the split and B right of
## it, each matching its own CPU develop.
import c
import memory
import strings
from luce_std import files
from luce_gpu import gpu
from luce_std import math
from luce_std import paths
from luce_develop import scene
from luce_develop import process
from luce_develop import renderer
from luce_develop.settings import parse, Settings
from luce_develop import recipe

let cases: str[22] = [
    "",
    "temperature=7000;tint=10;exposure=0.7;contrast=40;shadows=50;vibrance=60",
    "exposure=-1;highlights=-80;whites=30;blacks=-40;saturation=-50",
    "view=2;exposure=1.5",
    "view=0;exposure=1;contrast=20;vibrance=40",
    "view=1;orange_hue=40;orange_saturation=-60;blue_luminance=-50;green_saturation=80;grade_shadows_hue=200;grade_shadows_saturation=40;grade_highlights_hue=40;grade_highlights_saturation=30;grade_global_luminance=10",
    "bw=1;bw_tint_hue=40;bw_tint_amount=30;bw_red=120;bw_blue=-80;levels_black=0.05;levels_gamma=1.3;curve_rgb=0,0 0.25,0.2 0.75,0.85 1,1;curve_blue=0,0.05 1,0.95;curve_luma=0,0 0.5,0.55 1,1",
    "lens_vignetting=60;lens_midpoint=30;vignette_amount=-60;vignette_feather=70;vignette_roundness=40",
    "view=1;geometry_vertical=40;geometry_rotate=4;geometry_aspect=20;guides=0.1,0.1,0.12,0.9",
    "view=1;geometry_rotate=3;crop_left=0.1;crop_top=0.2;crop_right=0.8;crop_bottom=0.9;vignette_amount=-40",
    "view=1;film_stock=1;film_grain=0",
    "view=1;film_stock=1;develop_time=4.5;film_interimage=180;film_warmth=40;film_tint=-20;film_contrast=30;film_black=60;film_format=2",
    "view=1;film_stock=3;film_halation=300;film_grain=0;exposure=2",
    "view=3;exposure=0.5;saturation=20",
    "view=3;film_stock=1;film_grain=0",
    "view=1;film_stock=5;film_grain=0",
    "view=1;film_stock=5;film_grain=80",
    "view=1;film_stock=6;film_grain=120;develop_time=10;develop_temperature=22",
    "view=1;film_stock=3;film_grain=0;develop_silver=100;exposure=-1",
    "view=1;film_stock=6;film_grain=0;develop_process=13",
    "view=1;film_stock=5;film_grain=0;develop_process=2",
    "view=3;film_stock=1;film_grain=0;print_silver=100"]

## luce-raw's samples, as tests are run from this package's folder.
let samples: str[3] = ["../luce-raw/build/samples/leica_m240.dng", "../luce-raw/build/samples/fuji_xt2_xtrans_14c.raf",
                       "../luce-raw/build/samples/sony_a7m2_14c.arw"]

## Develop the file at `path` both ways with every case; how many failed.
func check_file(device: gpu.Device, path: str) -> i64!:
    var failed: i64 = 0
    for wanted in cases:
        let settings = parse(wanted)
        var cpu_scene = try scene.open(path, 384)
        defer cpu_scene.close()
        var expected = try process.render(&cpu_scene, settings)
        defer expected.close()
        let width = (u32)expected.width()
        let height = (u32)expected.height()
        var drawer = try renderer.create(gpu.Format.rgba8)
        defer drawer.close()
        drawer.show(try scene.open(path, 384))
        drawer.set_settings(settings)
        var texture = try gpu.Texture.create(device, width, height, gpu.Format.rgba8)
        defer texture.destroy()
        let frame = try texture.frame()
        defer frame.release()
        let target = try frame.value().target()
        defer target.release()
        try drawer.draw(target, 0.0, 0.0, (f64)width, (f64)height)
        _ = try frame.value().present(gpu.Color(0.0, 0.0, 0.0, 1.0))
        let shown = try new u8[(usize)(width * height * 4)] in memory.heap
        defer free(shown) in memory.heap
        try texture.read(shown)
        var total = 0.0
        var largest = 0
        var outliers = 0
        let want = expected.pixels()
        for at in 0..<shown.length:
            if at % 4 == 3:
                continue
            let difference = (i64)shown[at] - (i64)want[at]
            let size = difference if difference >= 0 else -difference
            total += (f64)size
            if size > largest:
                largest = size
            if size > 6:
                outliers += 1
        let mean = total / (f64)(shown.length // 4 * 3)
        # Interpolating the view's table across a sharp corner (the Linear
        # view's clip, the gamut's edge) misses by a few levels, rarely.
        let share = (f64)outliers / (f64)(shown.length // 4 * 3)
        # Film goes through nine half-float passes on the negative first, grain
        # included, so it may differ by a few levels more.
        let tabled = settings.get(.view) == 0.0 or settings.get(.view) == 3.0
        let limit = 40 if tabled else (8 if settings.get(.film_stock) > 0.0 else 3)
        let good = mean < 1.0 and share < 0.001 and largest < limit
        print(f"{"ok  " if good else "FAIL"}  {paths.base(path)}  [{wanted}]  mean {mean}  over 6: {outliers}  largest {largest}")
        if not good:
            failed += 1
    return failed

## A and B compared, the split at 0.4: each side within the film limit (8) of
## its own CPU develop (B: the recipe shown at Develop, scanned as is).
func check_compare(device: gpu.Device, path: str) -> i64!:
    var settings = parse("film_grain=0;contrast=40;saturation=-30")
    settings.recipe.set_compare((i64)recipe.Stage.develop)
    var shown_b = settings
    shown_b.recipe.display = settings.recipe.compare
    shown_b.recipe.compare = -1
    var cpu_scene = try scene.open(path, 384)
    defer cpu_scene.close()
    var expected_a = try process.render(&cpu_scene, settings)
    defer expected_a.close()
    var expected_b = try process.render(&cpu_scene, shown_b)
    defer expected_b.close()
    let width = (u32)expected_a.width()
    let height = (u32)expected_a.height()
    var drawer = try renderer.create(gpu.Format.rgba8)
    defer drawer.close()
    drawer.show(try scene.open(path, 384))
    drawer.set_settings(settings)
    drawer.set_split(0.4)
    var texture = try gpu.Texture.create(device, width, height, gpu.Format.rgba8)
    defer texture.destroy()
    let frame = try texture.frame()
    defer frame.release()
    let target = try frame.value().target()
    defer target.release()
    try drawer.draw(target, 0.0, 0.0, (f64)width, (f64)height)
    _ = try frame.value().present(gpu.Color(0.0, 0.0, 0.0, 1.0))
    let shown = try new u8[(usize)(width * height * 4)] in memory.heap
    defer free(shown) in memory.heap
    try texture.read(shown)
    let split = (usize)((f64)width * 0.4)
    var largest = 0
    var total = 0.0
    var differs = false
    for y in 0..<(usize)height:
        for x in 0..<(usize)width:
            # A column either side of the split may be either.
            if x + 1 >= split and x <= split:
                continue
            let want = expected_a.pixels() if x < split else expected_b.pixels()
            for k in 0..<(usize)3:
                let at = (y * (usize)width + x) * 4 + k
                let difference = (i64)shown[at] - (i64)want[at]
                let size = difference if difference >= 0 else -difference
                total += (f64)size
                largest = size if size > largest else largest
                if expected_a.pixels()[at] != expected_b.pixels()[at]:
                    differs = true
    let mean = total / (f64)(width * height * 3)
    let good = mean < 1.0 and largest < 8 and differs
    print(f"{"ok  " if good else "FAIL"}  {paths.base(path)}  [A | B at Develop]  mean {mean}  largest {largest}")
    return 0 if good else 1

## Whether a file is at `path`.
func present(path: str) -> bool!:
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    return files.exists((c.str)terminated)

pub func main(arguments: str[]) -> i32!:
    var device = gpu.Device.open() catch failure:
        print("skip: no GPU")
        return 0
    defer device.destroy()
    var failed: i64 = 0
    if arguments.length > 1:
        for path in arguments[1..]:
            failed += try check_file(device, path)
            failed += try check_compare(device, path)
        return 1 if failed > 0 else 0
    for sample in samples:
        if not try present(sample):
            print("skip: no sample raws in ../luce-raw/build/samples (luce-raw/tests/run.py fetches them)")
            return 0
    for sample in samples:
        failed += try check_file(device, sample)
        failed += try check_compare(device, sample)
    return 1 if failed > 0 else 0
