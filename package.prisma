    def dependency "luce-tiff" {
        str owner = "dymokomi"
        str path = "../luce-tiff"
    }

    def dependency "luce-heic" {
        str owner = "dymokomi"
        str path = "../luce-heic"
    }

    def dependency "luce-raster" {
        str owner = "dymokomi"
        str path = "../luce-raster"
    }

    def dependency "luce-color" {
        str owner = "dymokomi"
        str path = "../luce-color"
    }

    def dependency "luce-gpu" {
        str owner = "dymokomi"
        str path = "../luce-gpu"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
